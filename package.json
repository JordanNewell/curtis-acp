{
	"name": "curtis-acp",
	"version": "0.4.3",
	"description": "Curtis AI as an ACP agent — polyglot LLM access (53 providers) with the multi-model arena, inside Zed and any ACP client.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JordanNewell/curtis-acp.git"
	},
	"homepage": "https://jordannewell.com/curtis",
	"author": "Jordan Newell <jordan@jordannewell.com> (https://jordannewell.com)",
	"bugs": {
		"url": "https://github.com/JordanNewell/curtis-acp/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"curtis-acp": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsx src/index.ts",
		"prepublishOnly": "npm run build && npm run test:mock && npm run test:persist",
		"test:mock": "node test/client.mjs",
		"test:persist": "node test/persist.mjs"
	},
	"keywords": ["acp", "agent-client-protocol", "zed", "llm", "arena", "byok"],
	"license": "BUSL-1.1",
	"dependencies": {
		"@zed-industries/agent-client-protocol": "^0.4.5"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	},
	"overrides": {
		"zod": "^4.6.6"
	}
}
